---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="~/blog" description="All posts — essays, notes and write-ups.">
  <p>
    <a class="back" href="/">← back to home</a>
  </p>

  <h1>blog</h1>

  <p class="meta">
    ls -la ~/blog — {posts.length} {posts.length === 1 ? 'post' : 'posts'}
  </p>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <div class="post-row">
            <span class="date">{formatDate(post.data.pubDate)}</span>
            <a class="title" href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
            <span class="desc">{post.data.description}</span>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
